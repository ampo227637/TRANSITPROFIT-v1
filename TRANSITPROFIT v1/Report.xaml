<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TRANSITPROFIT_v1.Report"
             BackgroundColor="#64748B"
             Title="Reports">

    <Grid RowDefinitions="Auto,Auto,*,Auto" 
          Padding="16" 
          RowSpacing="16">

        <!-- Page Header -->
        <HorizontalStackLayout Grid.Row="0">
            <Label Text="Reports Dashboard" 
                   FontSize="24" 
                   TextColor="White"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   Margin="20, 10"/>

            <Button Text="EXPORT" 
                    Margin="20,0,0,0"
                    FontAttributes="Bold"
                    FontSize="17"
                    WidthRequest="100"
                    HeightRequest="20"
                    MinimumHeightRequest="30"
                    TextColor="White"
                    CornerRadius="4"
                    HorizontalOptions="End"
                    Padding="0"/>
        </HorizontalStackLayout>

        <!-- Filters Section -->
        <Frame Grid.Row="1" 
               Margin="20, 0"
               Padding="16" 
               CornerRadius="8"
               BackgroundColor="White"
               BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}">
            <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="16">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Date Range" FontAttributes="Bold" Margin="0,0,0,4" />
                    <Picker Title="Select Period" BackgroundColor="White">
                        <Picker.Items>
                            <x:String>Last 7 Days</x:String>
                            <x:String>Last 30 Days</x:String>
                            <x:String>Last Quarter</x:String>
                            <x:String>Custom Range</x:String>
                        </Picker.Items>
                    </Picker>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Route" FontAttributes="Bold" Margin="0,0,0,4" />
                    <Picker Title="Select Route" BackgroundColor="White">
                        <Picker.Items>
                            <x:String>All Routes</x:String>
                            <x:String>North Route</x:String>
                            <x:String>South Route</x:String>
                            <x:String>East Route</x:String>
                            <x:String>West Route</x:String>
                        </Picker.Items>
                    </Picker>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2">
                    <Label Text="Metric" FontAttributes="Bold" Margin="0,0,0,4" />
                    <Picker Title="Select Metric" BackgroundColor="White">
                        <Picker.Items>
                            <x:String>Revenue</x:String>
                            <x:String>Expenses</x:String>
                            <x:String>Profit</x:String>
                            <x:String>Passenger Count</x:String>
                            <x:String>Fuel Consumption</x:String>
                        </Picker.Items>
                    </Picker>
                </VerticalStackLayout>

                <Button Grid.Column="3"
                        Text="APPLY"
                        VerticalOptions="End"
                        HeightRequest="20"
                        MinimumHeightRequest="33"
                        TextColor="White"
                        CornerRadius="4" />
            </Grid>
        </Frame>

        <!-- Reports Content Section -->
        <ScrollView Grid.Row="2">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
                <!-- Summary Cards -->
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16"
                      Margin="20, 5">
                    <!-- Revenue Card -->
                    <Frame Grid.Column="0" 
                           Padding="16" 
                           CornerRadius="8"
                           BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}">
                        <VerticalStackLayout>
                            <Label Text="Total Revenue" 
                                   FontSize="14" 
                                   TextColor="{AppThemeBinding Light=#757575, Dark=#AAAAAA}" />
                            <Label Text="$452,680" 
                                   FontSize="22" 
                                   FontAttributes="Bold" />
                            <Label Text="↑ 12.4% vs last period" 
                                   FontSize="12" 
                                   TextColor="#4CAF50" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Expenses Card -->
                    <Frame Grid.Column="1" 
                           Padding="16" 
                           CornerRadius="8"
                           BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}">
                        <VerticalStackLayout>
                            <Label Text="Total Expenses" 
                                   FontSize="14" 
                                   TextColor="{AppThemeBinding Light=#757575, Dark=#AAAAAA}" />
                            <Label Text="$314,550" 
                                   FontSize="22" 
                                   FontAttributes="Bold" />
                            <Label Text="↑ 8.2% vs last period" 
                                   FontSize="12" 
                                   TextColor="#F44336" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Profit Card -->
                    <Frame Grid.Column="2" 
                           Padding="16" 
                           CornerRadius="8"
                           BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}">
                        <VerticalStackLayout>
                            <Label Text="Net Profit" 
                                   FontSize="14" 
                                   TextColor="{AppThemeBinding Light=#757575, Dark=#AAAAAA}" />
                            <Label Text="$138,130" 
                                   FontSize="22" 
                                   FontAttributes="Bold" />
                            <Label Text="↑ 16.7% vs last period" 
                                   FontSize="12" 
                                   TextColor="#4CAF50" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Utilization Card -->
                    <Frame Grid.Column="3" 
                           Padding="16" 
                           CornerRadius="8"
                           BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}">
                        <VerticalStackLayout>
                            <Label Text="Fleet Utilization" 
                                   FontSize="14" 
                                   TextColor="{AppThemeBinding Light=#757575, Dark=#AAAAAA}" />
                            <Label Text="87.5%" 
                                   FontSize="22" 
                                   FontAttributes="Bold" />
                            <Label Text="↑ 3.2% vs last period" 
                                   FontSize="12" 
                                   TextColor="#4CAF50" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- Chart Section -->
                <Frame Grid.Row="1" 
                       Padding="16" 
                       CornerRadius="8"
                       Margin="20, 10"
                       BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}">
                    <VerticalStackLayout>
                        <Label Text="Revenue vs Expenses Trend" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               Margin="0,0,0,10" />
                        <!-- Placeholder for chart -->
                        <Border BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#333333}"
                                StrokeShape="RoundRectangle 8"
                                HeightRequest="250">
                            <Label Text="Chart visualization would be displayed here" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center" 
                                   TextColor="{AppThemeBinding Light=#757575, Dark=#AAAAAA}" />
                        </Border>
                        <Label Text="Tap on chart points for detailed information" 
                               FontSize="12" 
                               TextColor="{AppThemeBinding Light=#757575, Dark=#AAAAAA}" 
                               Margin="0,10,0,0" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Data Table -->
                <Frame Grid.Row="2" 
                       Padding="16" 
                       CornerRadius="8"
                       Margin="20, 0"
                       BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="Auto,*,*,*,*">
                            <HorizontalStackLayout Grid.Column="0">
                                <Label Text="Detailed Reports" 
                                       FontSize="16" 
                                       FontAttributes="Bold" 
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Grid.Column="4" HorizontalOptions="End">
                                <Label Text="Search: " 
                                       VerticalOptions="Center" />
                                <Entry Placeholder="Filter results..." 
                                       WidthRequest="200" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Table Header -->
                        <Grid ColumnDefinitions="2*,*,*,*,*" 
                              Margin="0,16,0,0"
                              BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#303030}"
                              Padding="10">
                            <Label Grid.Column="0" Text="Route" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="Revenue" FontAttributes="Bold" />
                            <Label Grid.Column="2" Text="Expenses" FontAttributes="Bold" />
                            <Label Grid.Column="3" Text="Profit" FontAttributes="Bold" />
                            <Label Grid.Column="4" Text="Margin %" FontAttributes="Bold" />
                        </Grid>

                        <!-- Table Rows -->
                        <!-- Row 1 -->
                        <Grid ColumnDefinitions="2*,*,*,*,*" Padding="10">
                            <Label Grid.Column="0" Text="North Route" />
                            <Label Grid.Column="1" Text="$125,430" />
                            <Label Grid.Column="2" Text="$87,230" />
                            <Label Grid.Column="3" Text="$38,200" />
                            <Label Grid.Column="4" Text="30.4%" />
                        </Grid>

                        <!-- Row 2 -->
                        <Grid ColumnDefinitions="2*,*,*,*,*" 
                              BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#252525}"
                              Padding="10">
                            <Label Grid.Column="0" Text="South Route" />
                            <Label Grid.Column="1" Text="$143,820" />
                            <Label Grid.Column="2" Text="$96,450" />
                            <Label Grid.Column="3" Text="$47,370" />
                            <Label Grid.Column="4" Text="32.9%" />
                        </Grid>

                        <!-- Row 3 -->
                        <Grid ColumnDefinitions="2*,*,*,*,*" Padding="10">
                            <Label Grid.Column="0" Text="East Route" />
                            <Label Grid.Column="1" Text="$98,750" />
                            <Label Grid.Column="2" Text="$71,340" />
                            <Label Grid.Column="3" Text="$27,410" />
                            <Label Grid.Column="4" Text="27.8%" />
                        </Grid>

                        <!-- Row 4 -->
                        <Grid ColumnDefinitions="2*,*,*,*,*" 
                              BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#252525}"
                              Padding="10">
                            <Label Grid.Column="0" Text="West Route" />
                            <Label Grid.Column="1" Text="$84,680" />
                            <Label Grid.Column="2" Text="$59,530" />
                            <Label Grid.Column="3" Text="$25,150" />
                            <Label Grid.Column="4" Text="29.7%" />
                        </Grid>

                        <!-- Pagination -->
                        <HorizontalStackLayout HorizontalOptions="End" Margin="0,16,0,0">
                            <Button Text="Previous" 
                                    WidthRequest="100"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light=#0078D7, Dark=#4CC2FF}" />
                            <Label Text="Page 1 of 3" 
                                   VerticalOptions="Center" 
                                   Margin="16,0" />
                            <Button Text="Next" 
                                    WidthRequest="100"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light=#0078D7, Dark=#4CC2FF}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>
            </Grid>
        </ScrollView>

        <!-- Action Buttons -->
        <HorizontalStackLayout Grid.Row="3" 
                               HorizontalOptions="End" 
                               Spacing="12"
                               Margin="0, 0, 20, 0">
            <Button Text="Download PDF" 
                    WidthRequest="150"
                    BackgroundColor="White"
                    TextColor="{AppThemeBinding Light=#0078D7, Dark=#4CC2FF}"
                    BorderColor="{AppThemeBinding Light=#0078D7, Dark=#4CC2FF}"
                    BorderWidth="1"
                    CornerRadius="4" />

            <Button Text="Share Report" 
                    WidthRequest="150"
                    BackgroundColor="{AppThemeBinding Light=#0078D7, Dark=#4CC2FF}"
                    TextColor="White"
                    CornerRadius="4" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>