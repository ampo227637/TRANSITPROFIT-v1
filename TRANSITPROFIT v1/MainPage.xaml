<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TRANSITPROFIT_v1.MainPage"
             BackgroundColor="#F7FAFC">

    <Grid RowSpacing="10" 
          ColumnSpacing="10" 
          Padding="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Top Section: KPI Metrics -->
        <Grid Grid.Row="0" 
              ColumnSpacing="15" 
              RowSpacing="15" 
              BackgroundColor="#F7FAFC">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Revenue -->
            <Frame Grid.Column="0" 
                   BackgroundColor="White" 
                   CornerRadius="15" 
                   Padding="15" 
                   HasShadow="True">
                <StackLayout>
                    <Label Text="REVENUE" FontSize="18" TextColor="#4A5568" FontAttributes="Bold" />
                    <Label Text="$0.00" FontSize="30" TextColor="#1A202C" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </StackLayout>
            </Frame>

            <!-- Fuel Expenses -->
            <Frame Grid.Column="1" 
                   BackgroundColor="White" 
                   CornerRadius="15" 
                   Padding="15" 
                   HasShadow="True">
                <StackLayout>
                    <Label Text="FUEL EXPENSES" FontSize="18" TextColor="#4A5568" FontAttributes="Bold" />
                    <Label Text="$0.00" FontSize="30" TextColor="#E53E3E" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </StackLayout>
            </Frame>

            <!-- Passengers -->
            <Frame Grid.Column="2" 
                   BackgroundColor="White" 
                   CornerRadius="15" 
                   Padding="15" 
                   HasShadow="True">
                <StackLayout>
                    <Label Text="PASSENGERS" FontSize="18" TextColor="#4A5568" FontAttributes="Bold" />
                    <Label Text="0" FontSize="30" TextColor="#1A202C" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                </StackLayout>
            </Frame>

            <!-- Active Vehicle -->
            <Frame Grid.Column="3" 
                   BackgroundColor="White" 
                   CornerRadius="15" 
                   Padding="15" 
                   HasShadow="True">
                <StackLayout>
                    <Label Text="ACTIVE VEHICLE" FontSize="18" TextColor="#4A5568" FontAttributes="Bold" />
                    <Label Text="PLACIDA, CALLUMHIGHWAY, BANKING" FontSize="16" TextColor="#1A202C" />
                </StackLayout>
            </Frame>
        </Grid>

        <!-- Bottom Section: Drivers and Reports -->
        <Grid Grid.Row="1" ColumnSpacing="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Active Driver List -->
            <Frame Grid.Column="0" 
                   BackgroundColor="White" 
                   CornerRadius="15" 
                   Padding="15" 
                   HasShadow="True">
                <StackLayout>
                    <Label Text="ACTIVE DRIVER" FontSize="18" TextColor="#4A5568" FontAttributes="Bold" />
                    <CollectionView ItemsSource="{Binding ActiveDrivers}" SelectionMode="None" VerticalOptions="FillAndExpand">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Label Text="{Binding DriverId}" Grid.Column="0" FontSize="16" TextColor="#2D3748" />
                                    <Label Text="{Binding Unit}" Grid.Column="1" FontSize="16" TextColor="#2D3748" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Button Text="VIEW ALL" BackgroundColor="#3182CE" TextColor="White" CornerRadius="10" />
                </StackLayout>
            </Frame>

            <!-- Statistic Report (Graph) -->
            <Frame Grid.Column="1" 
                   BackgroundColor="White" 
                   CornerRadius="15" 
                   Padding="15" 
                   HasShadow="True">
                <StackLayout>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Label Text="STATISTIC REPORT" Grid.Column="0" FontSize="18" TextColor="#4A5568" FontAttributes="Bold" />
                        <Picker Grid.Column="1" FontSize="16" HorizontalOptions="End">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Daily</x:String>
                                    <x:String>Monthly</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Grid>
                    <Image Source="graph_placeholder.png" Aspect="AspectFit" HeightRequest="200" VerticalOptions="CenterAndExpand" />
                    <Button Text="EXPORT (EXCEL)" BackgroundColor="#48BB78" TextColor="White" CornerRadius="10" />
                </StackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>
