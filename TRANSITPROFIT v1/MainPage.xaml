<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TRANSITPROFIT_v1.MainPage"
             BackgroundColor="#FAFAFA">

    <ContentPage.Resources>
        <Style x:Key="KpiTitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="#64748B" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="KpiValueStyle" TargetType="Label">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="TextColor" Value="#1E293B" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="TextColor" Value="#1E293B" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="HeightRequest" Value="45" />
        </Style>
    </ContentPage.Resources>

    <Grid RowSpacing="15" 
          ColumnSpacing="15" 
          Padding="20"
          BackgroundColor="#445c84">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- App Title -->
            <RowDefinition Height="Auto" />
            <!-- KPI Cards -->
            <RowDefinition Height="Auto" />
            <!-- Filter/Date Section -->
            <RowDefinition Height="*" />
            <!-- Content Section -->
        </Grid.RowDefinitions>

        <!-- App Header -->
        <StackLayout Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Text="TransitProfit" FontSize="28" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
            <Label Text="Dashboard" FontSize="28" TextColor="Black" VerticalOptions="Center" Margin="5,0,0,0" />
            <Label Text="v1.0" FontSize="14" TextColor="#94A3B8" VerticalOptions="End" Margin="5,0,0,3" />
            <ImageButton Source="refresh_icon.png" 
                        HeightRequest="24" 
                        WidthRequest="24" 
                        BackgroundColor="Transparent"
                        HorizontalOptions="EndAndExpand"
                        VerticalOptions="Center" />
        </StackLayout>

        <!-- KPI Cards - Top Row -->
        <Grid Grid.Row="1" ColumnSpacing="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Revenue KPI -->
            <Frame Grid.Column="0" 
                   BackgroundColor="White" 
                   CornerRadius="12" 
                   Padding="15" 
                   HasShadow="True"
                   BorderColor="Transparent">
                <Grid RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Text="REVENUE" Style="{StaticResource KpiTitleStyle}" Grid.Row="0" />
                    <Label Text="$0.00" Style="{StaticResource KpiValueStyle}" Grid.Row="1" />
                    <StackLayout Orientation="Horizontal" Grid.Row="2">
                        <Label Text="↑ 0%" TextColor="#10B981" FontSize="14" />
                        <Label Text="vs last period" TextColor="#64748B" FontSize="14" Margin="5,0,0,0" />
                    </StackLayout>
                </Grid>
            </Frame>

            <!-- Fuel Expenses KPI -->
            <Frame Grid.Column="1" 
                   BackgroundColor="White" 
                   CornerRadius="12" 
                   Padding="15" 
                   HasShadow="True"
                   BorderColor="Transparent">
                <Grid RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Text="FUEL EXPENSES" Style="{StaticResource KpiTitleStyle}" Grid.Row="0" />
                    <Label Text="$0.00" TextColor="#EF4444" Style="{StaticResource KpiValueStyle}" Grid.Row="1" />
                    <StackLayout Orientation="Horizontal" Grid.Row="2">
                        <Label Text="↓ 0%" TextColor="#10B981" FontSize="14" />
                        <Label Text="vs last period" TextColor="#64748B" FontSize="14" Margin="5,0,0,0" />
                    </StackLayout>
                </Grid>
            </Frame>

            <!-- Passengers KPI -->
            <Frame Grid.Column="2" 
                   BackgroundColor="White" 
                   CornerRadius="12" 
                   Padding="15" 
                   HasShadow="True"
                   BorderColor="Transparent">
                <Grid RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Text="PASSENGERS" Style="{StaticResource KpiTitleStyle}" Grid.Row="0" />
                    <Label Text="0" Style="{StaticResource KpiValueStyle}" Grid.Row="1" />
                    <StackLayout Orientation="Horizontal" Grid.Row="2">
                        <Label Text="↑ 0%" TextColor="#10B981" FontSize="14" />
                        <Label Text="vs last period" TextColor="#64748B" FontSize="14" Margin="5,0,0,0" />
                    </StackLayout>
                </Grid>
            </Frame>

            <!-- Profit Margin KPI -->
            <Frame Grid.Column="3" 
                   BackgroundColor="White" 
                   CornerRadius="12" 
                   Padding="15" 
                   HasShadow="True"
                   BorderColor="Transparent">
                <Grid RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Text="PROFIT MARGIN" Style="{StaticResource KpiTitleStyle}" Grid.Row="0" />
                    <Label Text="0%" Style="{StaticResource KpiValueStyle}" Grid.Row="1" TextColor="#10B981" />
                    <StackLayout Orientation="Horizontal" Grid.Row="2">
                        <Label Text="↑ 0%" TextColor="#10B981" FontSize="14" />
                        <Label Text="vs last period" TextColor="#64748B" FontSize="14" Margin="5,0,0,0" />
                    </StackLayout>
                </Grid>
            </Frame>
        </Grid>

        <!-- Filter Controls -->
        <Grid Grid.Row="2" Margin="0,5,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Frame Grid.Column="0" 
                   BackgroundColor="White" 
                   CornerRadius="10" 
                   Padding="10,5" 
                   HasShadow="False"
                   BorderColor="#E2E8F0">
                <StackLayout Orientation="Horizontal">
                    <Label Text="Vehicle:" VerticalOptions="Center" TextColor="#64748B" FontSize="14" />
                    <Label Text="PLACIDA, CALLUMHIGHWAY" VerticalOptions="Center" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" Margin="5,0,0,0" />
                    <Image Source="dropdown_icon.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" Margin="5,0,0,0" />
                </StackLayout>
            </Frame>

            <StackLayout Orientation="Horizontal" Grid.Column="2" Spacing="10">
                <Frame BackgroundColor="White" 
                       CornerRadius="10" 
                       Padding="15,5" 
                       HasShadow="False"
                       BorderColor="#E2E8F0">
                    <StackLayout Orientation="Horizontal">
                        <Image Source="calendar_icon.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                        <Label Text="Feb 15 - Feb 25, 2025" VerticalOptions="Center" TextColor="#0F172A" FontSize="14" Margin="5,0,0,0" />
                    </StackLayout>
                </Frame>

                <Button Text="ACTIONS" 
                        BackgroundColor="#3B82F6" 
                        TextColor="White" 
                        CornerRadius="10"
                        HeightRequest="40"
                        WidthRequest="100"
                        FontAttributes="Bold"
                        FontSize="14" />
            </StackLayout>
        </Grid>

        <!-- Bottom Section: Drivers and Reports -->
        <Grid Grid.Row="3" ColumnSpacing="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column - Active Drivers & Vehicle Details -->
            <Grid Grid.Column="0" RowSpacing="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Active Driver List -->
                <Frame Grid.Row="0"
                       BackgroundColor="White" 
                       CornerRadius="12" 
                       Padding="15" 
                       HasShadow="True"
                       BorderColor="Transparent">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Text="ACTIVE DRIVERS" Style="{StaticResource SectionTitleStyle}" Grid.Column="0" />
                            <Label Text="4 drivers" TextColor="#64748B" FontSize="14" Grid.Column="1" VerticalOptions="Center" />
                        </Grid>

                        <CollectionView Grid.Row="1">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="5" Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Frame Grid.Column="0" 
                                               BackgroundColor="#EFF6FF" 
                                               CornerRadius="20" 
                                               HeightRequest="40" 
                                               WidthRequest="40"
                                               Padding="0"
                                               HasShadow="False">
                                            <Label Text="{Binding Initials}" 
                                                   HorizontalOptions="Center" 
                                                   VerticalOptions="Center" 
                                                   TextColor="#3B82F6" 
                                                   FontAttributes="Bold" />
                                        </Frame>

                                        <StackLayout Grid.Column="1" VerticalOptions="Center" Margin="10,0">
                                            <Label Text="{Binding DriverId}" FontSize="16" TextColor="#0F172A" FontAttributes="Bold" />
                                            <Label Text="{Binding Status}" FontSize="14" TextColor="#64748B" />
                                        </StackLayout>

                                        <Label Text="{Binding Unit}" Grid.Column="2" FontSize="16" TextColor="#0F172A" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                            <!-- Sample Data for Preview -->
                            <CollectionView.ItemsSource>
                                <x:Array Type="{x:Type x:Object}">
                                    <x:Object>
                                        <!-- <x:Arguments>
                                            <x:String>John Smith</x:String>
                                            <x:String>On Route</x:String>
                                            <x:String>A01</x:String>
                                            <x:String>JS</x:String>
                                        </x:Arguments>-->
                                    </x:Object>
                                    <x:Object>
                                        <!-- <x:Arguments>
                                            <x:String>Maria Garcia</x:String>
                                            <x:String>At Terminal</x:String>
                                            <x:String>B22</x:String>
                                            <x:String>MG</x:String>
                                        </x:Arguments>-->
                                    </x:Object>
                                </x:Array>
                            </CollectionView.ItemsSource>
                        </CollectionView>

                        <Button Grid.Row="2" 
                                Text="VIEW ALL DRIVERS" 
                                BackgroundColor="#3B82F6" 
                                Style="{StaticResource ActionButtonStyle}" />
                    </Grid>
                </Frame>

                <!-- Vehicle Status Card -->

            </Grid>

            <!-- Right Column - Reports and Insights -->
            <Grid Grid.Column="1" RowSpacing="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <Frame Grid.Row="0"
                       BackgroundColor="White" 
                       CornerRadius="12" 
                       Padding="15" 
                       HasShadow="True"
                       BorderColor="Transparent">
                     <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Text="ACTIVE VEHICLE" Style="{StaticResource SectionTitleStyle}" Grid.Row="0" />

                        <Grid Grid.Row="1" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackLayout Grid.Row="0">
                                <Label Text="PLACIDA, CALLUMHIGHWAY, BANKING" FontSize="16" TextColor="#0F172A" FontAttributes="Bold" />
                                <Label Text="Route Status: Active" TextColor="#10B981" FontSize="14" Margin="0,5,0,0" />
                            </StackLayout>

                            <Grid Grid.Row="1" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Frame Grid.Column="0" BackgroundColor="#F1F5F9" CornerRadius="8" Padding="10" HasShadow="False">
                                    <StackLayout>
                                        <Label Text="Fuel Level" FontSize="12" TextColor="#64748B" />
                                        <Label Text="87%" FontSize="16" TextColor="#0F172A" FontAttributes="Bold" />
                                    </StackLayout>
                                </Frame>

                                <Frame Grid.Column="1" BackgroundColor="#F1F5F9" CornerRadius="8" Padding="10" HasShadow="False">
                                    <StackLayout>
                                        <Label Text="Distance" FontSize="12" TextColor="#64748B" />
                                        <Label Text="124 km" FontSize="16" TextColor="#0F172A" FontAttributes="Bold" />
                                    </StackLayout>
                                </Frame>

                                <Frame Grid.Column="2" BackgroundColor="#F1F5F9" CornerRadius="8" Padding="10" HasShadow="False">
                                    <StackLayout>
                                        <Label Text="Est. Arrival" FontSize="12" TextColor="#64748B" />
                                        <Label Text="2:30 PM" FontSize="16" TextColor="#0F172A" FontAttributes="Bold" />
                                    </StackLayout>
                                </Frame>
                            </Grid>
                        </Grid>
                    </Grid>
                </Frame>



            </Grid>

        </Grid>
    </Grid>

</ContentPage>