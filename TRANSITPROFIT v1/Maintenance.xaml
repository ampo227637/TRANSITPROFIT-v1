<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TRANSITPROFIT_v1.Maintenance"
             Title="Maintenance"
             BackgroundColor="#121212">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="HeaderLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="Margin" Value="0,0,0,5" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="#1E1E1E" />
                <Setter Property="BorderColor" Value="#333333" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="15" />
                <Setter Property="Margin" Value="0,0,0,15" />
            </Style>
            <Style x:Key="DataLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="#E0E0E0" />
                <Setter Property="Margin" Value="0,3,0,3" />
            </Style>
            <Style x:Key="StatusLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="0,5,0,0" />
            </Style>
            <Style x:Key="FilterButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#2E1A47" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BorderColor" Value="#5A20CB" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="15,8" />
                <Setter Property="Margin" Value="0,0,10,0" />
            </Style>
            <Style x:Key="ActiveFilterButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#5A20CB" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="BorderColor" Value="#9A73E5" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="15,8" />
                <Setter Property="Margin" Value="0,0,10,0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Padding="15" RowSpacing="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Unit Summary Card -->
            <RowDefinition Height="Auto" />
            <!-- Maintenance Items Card -->
            <RowDefinition Height="Auto" />
            <!-- Analytics Dashboard -->
            <RowDefinition Height="Auto" />
            <!-- Search and Filters -->
            <RowDefinition Height="*" />
            <!-- Maintenance List -->
        </Grid.RowDefinitions>

        <!-- Unit Summary Card -->
        <Frame Grid.Row="0" Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Vehicle Image -->
                <Frame Grid.Column="0" BackgroundColor="#2A2A2A" CornerRadius="8" 
                       HeightRequest="120" WidthRequest="120" Padding="0"
                       IsClippedToBounds="True">
                    <Image Source="placeholder_vehicle.png" Aspect="AspectFill" />
                </Frame>

                <!-- Unit Details -->
                <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="6">
                    <Label Text="E-JEEP 01" FontSize="20" FontAttributes="Bold" TextColor="White"/>

                    <Grid ColumnSpacing="5" RowSpacing="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Text="Driver:" Grid.Row="0" Grid.Column="0" TextColor="#AAAAAA"/>
                        <Label Text="Juan Dela Cruz" Grid.Row="0" Grid.Column="1" TextColor="White"/>

                        <Label Text="Last Checkup:" Grid.Row="1" Grid.Column="0" TextColor="#AAAAAA"/>
                        <Label Text="Feb 22, 2025" Grid.Row="1" Grid.Column="1" TextColor="White"/>

                        <Label Text="Status:" Grid.Row="2" Grid.Column="0" TextColor="#AAAAAA"/>
                        <Label Text="READY TO RUN" Grid.Row="2" Grid.Column="1" TextColor="#4CAF50" FontAttributes="Bold"/>
                    </Grid>
                </StackLayout>

                <!-- Quick Actions -->
                <StackLayout Grid.Column="2" VerticalOptions="Center" Spacing="10">
                    <Button Text="Schedule Service" 
                            BackgroundColor="#5A20CB" 
                            TextColor="White"
                            CornerRadius="20"
                            Padding="15,8"
                            FontSize="12"/>
                    <Button Text="Maintenance History" 
                            BackgroundColor="Transparent" 
                            TextColor="#9A73E5"
                            BorderColor="#9A73E5"
                            BorderWidth="1"
                            CornerRadius="20"
                            Padding="15,8"
                            FontSize="12"/>
                </StackLayout>
            </Grid>
        </Frame>

        <!-- Maintenance Items Card -->
        <Frame Grid.Row="1" Style="{StaticResource CardStyle}">
            <StackLayout Spacing="15">
                <Grid>
                    <Label Text="MAINTENANCE ITEMS" Style="{StaticResource HeaderLabelStyle}" 
                           VerticalOptions="Center"/>
                    <Button Text="Export Report" 
                            HorizontalOptions="End"
                            BackgroundColor="Transparent"
                            TextColor="#9A73E5"
                            BorderColor="#9A73E5" 
                            BorderWidth="1"
                            CornerRadius="20"
                            Padding="15,5"
                            FontSize="12"/>
                </Grid>

                <Grid ColumnSpacing="15" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Headers -->
                    <Label Text="Component" TextColor="#AAAAAA" Grid.Row="0" Grid.Column="0" />
                    <Label Text="Status" TextColor="#AAAAAA" Grid.Row="0" Grid.Column="1" HorizontalTextAlignment="Center" />
                    <Label Text="Next Service" TextColor="#AAAAAA" Grid.Row="0" Grid.Column="2" HorizontalTextAlignment="Center" />
                    <Label Text="Priority" TextColor="#AAAAAA" Grid.Row="0" Grid.Column="3" HorizontalTextAlignment="Center" />

                    <!-- Engine Check -->
                    <Label Text="Engine" TextColor="White" Grid.Row="1" Grid.Column="0" VerticalOptions="Center" />
                    <Frame Grid.Row="1" Grid.Column="1" BackgroundColor="#4CAF50" CornerRadius="12" 
                           HeightRequest="24" WidthRequest="80" Padding="5,0" HorizontalOptions="Center">
                        <Label Text="GOOD" TextColor="White" FontSize="12" FontAttributes="Bold" 
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Frame>
                    <Label Text="Mar 26, 2025" TextColor="White" Grid.Row="1" Grid.Column="2" VerticalOptions="Center" />
                    <Label Text="Low" TextColor="#4CAF50" Grid.Row="1" Grid.Column="3" VerticalOptions="Center" HorizontalTextAlignment="Center" />

                    <!-- Lights and Signals -->
                    <Label Text="Lights and Signals" TextColor="White" Grid.Row="2" Grid.Column="0" VerticalOptions="Center" />
                    <Frame Grid.Row="2" Grid.Column="1" BackgroundColor="#F44336" CornerRadius="12" 
                           HeightRequest="24" WidthRequest="80" Padding="5,0" HorizontalOptions="Center">
                        <Label Text="REPAIR" TextColor="White" FontSize="12" FontAttributes="Bold" 
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Frame>
                    <Label Text="ASAP" TextColor="#F44336" Grid.Row="2" Grid.Column="2" VerticalOptions="Center" FontAttributes="Bold" />
                    <Label Text="High" TextColor="#F44336" Grid.Row="2" Grid.Column="3" VerticalOptions="Center" HorizontalTextAlignment="Center" FontAttributes="Bold" />

                    <!-- Tires -->
                    <Label Text="Tires" TextColor="White" Grid.Row="3" Grid.Column="0" VerticalOptions="Center" />
                    <Frame Grid.Row="3" Grid.Column="1" BackgroundColor="#4CAF50" CornerRadius="12" 
                           HeightRequest="24" WidthRequest="80" Padding="5,0" HorizontalOptions="Center">
                        <Label Text="GOOD" TextColor="White" FontSize="12" FontAttributes="Bold" 
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Frame>
                    <Label Text="Apr 15, 2025" TextColor="White" Grid.Row="3" Grid.Column="2" VerticalOptions="Center" />
                    <Label Text="Low" TextColor="#4CAF50" Grid.Row="3" Grid.Column="3" VerticalOptions="Center" HorizontalTextAlignment="Center" />

                    <!-- Battery -->
                    <Label Text="Battery" TextColor="White" Grid.Row="4" Grid.Column="0" VerticalOptions="Center" />
                    <Frame Grid.Row="4" Grid.Column="1" BackgroundColor="#F44336" CornerRadius="12" 
                           HeightRequest="24" WidthRequest="80" Padding="5,0" HorizontalOptions="Center">
                        <Label Text="REPAIR" TextColor="White" FontSize="12" FontAttributes="Bold" 
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Frame>
                    <Label Text="ASAP" TextColor="#F44336" Grid.Row="4" Grid.Column="2" VerticalOptions="Center" FontAttributes="Bold" />
                    <Label Text="Medium" TextColor="#FF9800" Grid.Row="4" Grid.Column="3" VerticalOptions="Center" HorizontalTextAlignment="Center" />

                    <!-- Brakes -->
                    <Label Text="Brakes" TextColor="White" Grid.Row="5" Grid.Column="0" VerticalOptions="Center" />
                    <Frame Grid.Row="5" Grid.Column="1" BackgroundColor="#4CAF50" CornerRadius="12" 
                           HeightRequest="24" WidthRequest="80" Padding="5,0" HorizontalOptions="Center">
                        <Label Text="GOOD" TextColor="White" FontSize="12" FontAttributes="Bold" 
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Frame>
                    <Label Text="Apr 10, 2025" TextColor="White" Grid.Row="5" Grid.Column="2" VerticalOptions="Center" />
                    <Label Text="Low" TextColor="#4CAF50" Grid.Row="5" Grid.Column="3" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                </Grid>

                <Grid ColumnSpacing="15" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Grid.Column="0" Text="Schedule Repairs" 
                            BackgroundColor="#F44336" 
                            TextColor="White"
                            CornerRadius="8"/>
                    <Button Grid.Column="1" Text="View Detailed Report" 
                            BackgroundColor="#333333" 
                            TextColor="White"
                            CornerRadius="8"/>
                </Grid>
            </StackLayout>
        </Frame>

        <!-- Analytics Dashboard -->
        <Frame Grid.Row="2" Style="{StaticResource CardStyle}">
            <StackLayout Spacing="15">
                <Label Text="MAINTENANCE ANALYTICS" Style="{StaticResource HeaderLabelStyle}" />

                <Grid ColumnSpacing="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Fleet Health Status -->
                    <Frame Grid.Column="0" BackgroundColor="#2A2A2A" CornerRadius="8" Padding="10">
                        <StackLayout>
                            <Label Text="Fleet Health" TextColor="#AAAAAA" FontSize="12" />
                            <Label Text="78%" TextColor="#4CAF50" FontSize="24" FontAttributes="Bold" />
                            <Label Text="↑ 3% from last month" TextColor="#4CAF50" FontSize="11" />
                        </StackLayout>
                    </Frame>

                    <!-- Pending Repairs -->
                    <Frame Grid.Column="1" BackgroundColor="#2A2A2A" CornerRadius="8" Padding="10">
                        <StackLayout>
                            <Label Text="Pending Repairs" TextColor="#AAAAAA" FontSize="12" />
                            <Label Text="12" TextColor="#F44336" FontSize="24" FontAttributes="Bold" />
                            <Label Text="4 high priority" TextColor="#F44336" FontSize="11" />
                        </StackLayout>
                    </Frame>

                    <!-- Maintenance Cost -->
                    <Frame Grid.Column="2" BackgroundColor="#2A2A2A" CornerRadius="8" Padding="10">
                        <StackLayout>
                            <Label Text="Maint. Cost (MTD)" TextColor="#AAAAAA" FontSize="12" />
                            <Label Text="₱45,230" TextColor="White" FontSize="24" FontAttributes="Bold" />
                            <Label Text="Under budget by 5%" TextColor="#4CAF50" FontSize="11" />
                        </StackLayout>
                    </Frame>
                </Grid>

                <Button Text="View Full Analytics Dashboard" 
                        BackgroundColor="#2A2A2A" 
                        TextColor="#9A73E5"
                        BorderColor="#9A73E5"
                        BorderWidth="1"
                        CornerRadius="8"
                        HorizontalOptions="Center"/>
            </StackLayout>
        </Frame>

        <!-- Search and Filters -->
        <Frame Grid.Row="3" Style="{StaticResource CardStyle}" Padding="15,10">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search Bar with Filter Icon -->
                <Frame Grid.Row="0" BackgroundColor="#2A2A2A" BorderColor="#333333" CornerRadius="25" Padding="5,0" HeightRequest="40">
                    <Grid ColumnSpacing="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Source="search_icon.png" HeightRequest="18" WidthRequest="18" Margin="10,0,0,0" />
                        <Entry Grid.Column="1" Placeholder="Search units, drivers, or issues..." PlaceholderColor="#888888" 
                               TextColor="White" BackgroundColor="Transparent" />
                        <Image Grid.Column="2" Source="filter_icon.png" HeightRequest="18" WidthRequest="18" Margin="0,0,10,0" />
                    </Grid>
                </Frame>

                <!-- Filter Buttons -->
                <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="ALL" Style="{StaticResource ActiveFilterButtonStyle}" />
                        <Button Text="E-JEEP" Style="{StaticResource FilterButtonStyle}" />
                        <Button Text="EURO" Style="{StaticResource FilterButtonStyle}" />
                        <Button Text="NEEDS REPAIR" Style="{StaticResource FilterButtonStyle}" />
                        <Button Text="SCHEDULED" Style="{StaticResource FilterButtonStyle}" />
                    </HorizontalStackLayout>
                </ScrollView>
            </Grid>
        </Frame>

        <!-- Maintenance List -->
        <Frame Grid.Row="4" Style="{StaticResource CardStyle}" Padding="0">
            <StackLayout>
                <!-- List Header -->
                <Grid BackgroundColor="#2A2A2A" Padding="15,10" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label Text="UNIT" TextColor="#AAAAAA" FontAttributes="Bold" Grid.Column="0" />
                    <Label Text="LAST CHECKUP" TextColor="#AAAAAA" FontAttributes="Bold" Grid.Column="1" />
                    <Label Text="STATUS" TextColor="#AAAAAA" FontAttributes="Bold" Grid.Column="2" />
                    <Label Text="ACTIONS" TextColor="#AAAAAA" FontAttributes="Bold" Grid.Column="3" />
                </Grid>

                <!-- List Items (Sample data) -->
                <ScrollView>
                    <StackLayout>
                        <!-- Item 1 -->
                        <Grid Padding="15,12" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Text="E-JEEP 01" TextColor="White" Grid.Column="0" VerticalOptions="Center" />
                            <Label Text="Feb 22, 2025" TextColor="White" Grid.Column="1" VerticalOptions="Center" />
                            <Frame Grid.Column="2" BackgroundColor="#1A3A26" CornerRadius="12" 
                                   HeightRequest="24" WidthRequest="110" Padding="5,0" HorizontalOptions="Start" VerticalOptions="Center">
                                <Label Text="READY TO RUN" TextColor="#4CAF50" FontSize="12" FontAttributes="Bold" 
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <Button Grid.Column="3" Text="View" 
                                    BackgroundColor="Transparent" 
                                    TextColor="#9A73E5"
                                    BorderColor="#9A73E5"
                                    BorderWidth="1"
                                    CornerRadius="15"
                                    Padding="15,0"
                                    HeightRequest="30"
                                    FontSize="12"/>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#333333" />

                        <!-- Item 2 -->
                        <Grid Padding="15,12" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Text="E-JEEP 03" TextColor="White" Grid.Column="0" VerticalOptions="Center" />
                            <Label Text="Feb 20, 2025" TextColor="White" Grid.Column="1" VerticalOptions="Center" />
                            <Frame Grid.Column="2" BackgroundColor="#3A1A1A" CornerRadius="12" 
                                   HeightRequest="24" WidthRequest="110" Padding="5,0" HorizontalOptions="Start" VerticalOptions="Center">
                                <Label Text="NEEDS REPAIR" TextColor="#F44336" FontSize="12" FontAttributes="Bold" 
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <Button Grid.Column="3" Text="View" 
                                    BackgroundColor="Transparent" 
                                    TextColor="#9A73E5"
                                    BorderColor="#9A73E5"
                                    BorderWidth="1"
                                    CornerRadius="15"
                                    Padding="15,0"
                                    HeightRequest="30"
                                    FontSize="12"/>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#333333" />

                        <!-- Item 3 -->
                        <Grid Padding="15,12" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Text="EURO 02" TextColor="White" Grid.Column="0" VerticalOptions="Center" />
                            <Label Text="Feb 15, 2025" TextColor="White" Grid.Column="1" VerticalOptions="Center" />
                            <Frame Grid.Column="2" BackgroundColor="#3A331A" CornerRadius="12" 
                                   HeightRequest="24" WidthRequest="110" Padding="5,0" HorizontalOptions="Start" VerticalOptions="Center">
                                <Label Text="SCHEDULED" TextColor="#FFC107" FontSize="12" FontAttributes="Bold" 
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Frame>
                            <Button Grid.Column="3" Text="View" 
                                    BackgroundColor="Transparent" 
                                    TextColor="#9A73E5"
                                    BorderColor="#9A73E5"
                                    BorderWidth="1"
                                    CornerRadius="15"
                                    Padding="15,0"
                                    HeightRequest="30"
                                    FontSize="12"/>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#333333" />
                    </StackLayout>
                </ScrollView>
            </StackLayout>
        </Frame>
    </Grid>
</ContentPage>