<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TRANSITPROFIT_v1.Login"
             BackgroundColor="LightGray"
             >


    <Grid Padding="0"
          Grid.Column="0">

        <Grid.RowDefinitions>
            <RowDefinition Height="500" />
        </Grid.RowDefinitions>
        <Image Source="backgroundlado.png" Opacity="0.7" Aspect="AspectFill"/>
        <BoxView Color="Black"
             Opacity="0.4"
             CornerRadius="10"
             WidthRequest="708"
             HeightRequest="408"
             />

        <!-- Login Form -->
        <Frame Padding="30" CornerRadius="5" BackgroundColor="White" HeightRequest="400"
                   WidthRequest="700" VerticalOptions="Center" HorizontalOptions="Center" HasShadow="True">

            <Grid>
                <Frame BackgroundColor="#f29c51" CornerRadius="5" HeightRequest="404" WidthRequest="300"
                       VerticalOptions="Center" HorizontalOptions="Center" Margin="0, 0, 440, 0">
                    <VerticalStackLayout HeightRequest="400">
                        <Label Text="Welcome!"
                       FontSize="26" FontAttributes="Bold" TextColor="White" FontFamily="Tahoma"
                       HorizontalOptions="Center" Margin="20, 20, 0, 0" />

                        <Image Source="logo.png"
                       HeightRequest="150" WidthRequest="130"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                               Margin="20, 0, 0, 0"/>

                        <Label Text="LAGAO DRIVERS OPERATORS TRANSPORT COOPERATIVE"
                           Margin="15, 0, 0, 0"
                           FontSize="12" FontAttributes="Bold" TextColor="White" FontFamily="Tahoma"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center"/>

                        <Label Text="Register your Account"
                               FontAttributes="Italic"
                               FontSize="12"
                               Margin="20, 90, 5, 0"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>

                        <Button Text="REGISTER"
                                x:Name="regis_newAccount"
                                FontFamily="Tahoma"
                                FontAttributes="Bold"
                                CornerRadius="5"
                                Margin="20, 0, 0, 0"
                                FontSize="10"
                                HeightRequest="20"
                                MinimumHeightRequest="27"
                                BackgroundColor="#ee7811"
                                HorizontalOptions="Fill"
                                Clicked="OnRegisNAButtonClicked"/>

                    </VerticalStackLayout>
                </Frame>

                <VerticalStackLayout Spacing="20" Margin="290, 0, 20, 0">

                    <!-- Username Input -->
                    <Label Text="Login Account" FontSize="Medium" TextColor="Black" FontFamily="Tahoma"
                           HorizontalOptions="Center"/>
                    <Label Text="Username: " TextColor="Black" FontSize="14" Margin="0, 17, 0, 0" FontFamily="Tahoma"/>
                    <Entry x:Name="usernameEntry" Margin="0, -15, 0, 0"
                       Placeholder="Username" PlaceholderColor="Gray"
                       TextColor="Black" FontSize="12"
                       BackgroundColor="Transparent"
                       HorizontalOptions="FillAndExpand" />


                    <!-- Password Input -->
                    <Label Text="Password: " TextColor="Black" FontSize="14" FontFamily="Tahoma"/>
                    <Entry Placeholder="Password" Margin="0, -15, 0, 0"
                       x:Name="userpassword" PlaceholderColor="Gray"
                       IsPassword="true" TextColor="Black" FontSize="12"
                       BackgroundColor="Transparent"
                       HorizontalOptions="Fill" />
                    <HorizontalStackLayout HorizontalOptions="End">
                        <CheckBox x:Name="ShowPasswordCheckBox" Margin="0, -25.5, -12, 0"/>
                        <Label Text="Show Password" Margin="0, -11.5, 0, 0" FontSize="12"/>
                    </HorizontalStackLayout>
                    <!-- Login Button -->
                    <Button Text="LOGIN" FontFamily="Tahoma" FontAttributes="Bold"
                        FontSize="16" BackgroundColor="#ee7811" TextColor="White"
                        CornerRadius="5" Padding="10"
                        Margin="0,-10,0,0"
                        Clicked="OnLoginClicked"
                        HorizontalOptions="Fill" />

                    <!-- Forgot Password -->
                    <Label 
                       x:Name="fogot_password" Text="forgot password" TextDecorations="Underline" FontFamily="Tahoma" FontAttributes="Italic"
                       TextColor="Black" FontSize="14"
                       HorizontalOptions="Center"
                       Margin="0, -10,0,0" />

                </VerticalStackLayout>
            </Grid>
        </Frame>
    </Grid>
</ContentPage>
